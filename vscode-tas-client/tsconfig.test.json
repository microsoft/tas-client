{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "rootDir": "..",
        "noEmit": true,
        "esModuleInterop": true,
        "types": ["node"],
        "paths": {
            "tas-client": ["../tas-client/src/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "out"]
}
